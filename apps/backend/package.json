{
  "name": "@repo/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "test": "vitest run",
    "prisma": "prisma",
    "login:create": "tsx --env-file=.env src/cli/loginCreate.ts",
    "login:set-password": "tsx --env-file=.env src/cli/loginSetPassword.ts",
    "member:set-role": "tsx --env-file=.env src/cli/memberSetRole.ts",
    "db:seed": "tsx --env-file=.env src/cli/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@repo/enrollment": "workspace:*",
    "@repo/shared": "workspace:*",
    "fastify": "5.12.8",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxlint": "catalog:",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
