NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Local databases from docker-compose.yml. Tests only ever use DATABASE_URL_TEST.
DATABASE_URL=postgresql://minotaur:minotaur@localhost:5433/minotaur_dev
DATABASE_URL_TEST=postgresql://minotaur:minotaur@localhost:5433/minotaur_test

# Origin of the web app. Data-changing requests with a session cookie must come from here.
WEB_ORIGIN=http://localhost:5173

# IANA time zone of the gym. Decides which day "today" is for attendance.
GYM_TIME_ZONE=Europe/Zagreb

# pnpm --filter @repo/backend db:seed adds demo data to the development
# database. Its two demo trainers log in with the test password
# demo-trainer-2026 (development only, see src/cli/seed.ts).
