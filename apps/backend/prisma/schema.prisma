generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

// Mirrors memberRole in @repo/shared.
enum MemberRole {
  child
  member
  trainer
  admin

  @@map("member_role")
}

// Mirrors weekday in @repo/shared.
enum Weekday {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday

  @@map("weekday")
}

datasource db {
  provider = "postgresql"
}

model Org {
  id          Int      @id @default(autoincrement())
  name        String
  contactName String
  email       String
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz
  members     Member[]

  @@map("org")
}

model Guardian {
  id        Int              @id @default(autoincrement())
  name      String
  surname   String
  email     String?
  phone     String?
  createdAt DateTime         @default(now()) @db.Timestamptz
  updatedAt DateTime         @updatedAt @db.Timestamptz
  members   MemberGuardian[]

  @@map("guardian")
}

model Member {
  id        Int              @id @default(autoincrement())
  orgId     Int
  name      String
  surname   String
  birthday  DateTime         @db.Date
  role      MemberRole       @default(child)
  taxNumber String?          @unique
  email     String?
  phone     String?
  createdAt DateTime         @default(now()) @db.Timestamptz
  updatedAt DateTime         @updatedAt @db.Timestamptz
  org       Org              @relation(fields: [orgId], references: [id], onDelete: Restrict)
  guardians MemberGuardian[]
  login     Login?
  sessions  Session[]
  groups    Group[]

  // People who can log in never share an email. The roles listed here must
  // match LOGIN_ROLES in @repo/shared/auth. Written the way Postgres stores
  // the condition, so Prisma does not see a difference and recreate it.
  @@unique([email], map: "member_login_email_key", where: raw("role = ANY (ARRAY['trainer'::member_role, 'admin'::member_role])"))
  @@index([orgId])
  @@map("member")
}

// A member's password. Login uses the member's email; there is none here.
model Login {
  memberId     Int      @id
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("login")
}

// id is the SHA-256 hash of the session token; the token itself is never stored.
model Session {
  id        String   @id
  memberId  Int
  expiresAt DateTime @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("session")
}

model MemberGuardian {
  memberId   Int
  guardianId Int
  createdAt  DateTime @default(now()) @db.Timestamptz
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Restrict)

  @@id([memberId, guardianId])
  @@index([guardianId])
  @@map("member_guardian")
}

// A training group. The owner is a member with the trainer role; the service
// checks that, the database only knows the member exists.
model Group {
  id        Int       @id @default(autoincrement())
  ownerId   Int
  days      Weekday[]
  // Wall-clock times at the gym, without a date or a time zone.
  from      DateTime  @db.Time(0)
  to        DateTime  @db.Time(0)
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  owner     Member    @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId])
  @@map("group")
}
