generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

// Mirrors memberRole in @repo/shared.
enum MemberRole {
  child
  member
  trainer
  admin

  @@map("member_role")
}

// Mirrors weekday in @repo/shared.
enum Weekday {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday

  @@map("weekday")
}

// Mirrors auditAction in @repo/shared.
enum AuditAction {
  member_created
  member_updated
  member_archived
  member_role_changed
  member_new_set
  login_created
  login_password_set
  group_created
  group_updated
  group_archived
  group_member_added
  group_member_removed
  training_session_added
  training_session_deleted
  month_sessions_created
  attendance_marked
  attendance_unmarked
  month_member_added
  month_member_removed
  month_subscription_set
  month_paid_set
  month_comment_set
  subscription_created
  subscription_updated
  enrollment_request_created
  enrollment_request_deleted
  enrollment_child_group_set
  enrollment_child_accepted
  enrollment_child_rejected
  enrollment_child_reopened

  @@map("audit_action")
}

// Mirrors enrollmentChildStatus in @repo/shared.
enum EnrollmentChildStatus {
  pending
  accepted
  rejected

  @@map("enrollment_child_status")
}

datasource db {
  provider = "postgresql"
}

model Org {
  id          Int      @id @default(autoincrement())
  name        String
  contactName String
  email       String
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz
  members     Member[]

  @@map("org")
}

model Guardian {
  id                 Int                 @id @default(autoincrement())
  name               String
  surname            String?
  email              String?
  phone              String?
  createdAt          DateTime            @default(now()) @db.Timestamptz
  updatedAt          DateTime            @updatedAt @db.Timestamptz
  members            MemberGuardian[]
  enrollmentRequests EnrollmentRequest[]

  @@map("guardian")
}

model Member {
  id               Int                @id @default(autoincrement())
  orgId            Int
  name             String
  surname          String
  birthday         DateTime?          @db.Date
  role             MemberRole         @default(child)
  // Shows the "New" badge in groups and on attendance. Set when the member
  // comes in through an enrollment request; trainers and admins clear it.
  isNew            Boolean            @default(false)
  taxNumber        String?
  email            String?
  phone            String?
  createdAt        DateTime           @default(now()) @db.Timestamptz
  updatedAt        DateTime           @updatedAt @db.Timestamptz
  // Set when the member is archived. Archived members are hidden but kept for history.
  deletedAt        DateTime?          @db.Timestamptz
  org              Org                @relation(fields: [orgId], references: [id], onDelete: Restrict)
  guardians        MemberGuardian[]
  login            Login?
  sessions         Session[]
  ownedGroups      Group[]
  enrollments      EnrollmentChild[]
  groupMemberships GroupMember[]
  attendance       Attendance[]
  monthMemberships GroupMonthMember[]
  months           MemberMonth[]
  auditActions     AuditEvent[]       @relation("AuditActor")
  auditEvents      AuditEvent[]       @relation("AuditMember")

  // Active people who can log in never share an email. The roles listed here must
  // match LOGIN_ROLES in @repo/shared/auth. Written the way Postgres stores
  // the condition, so Prisma does not see a difference and recreate it.
  @@unique([email], map: "member_login_email_key", where: raw("((role = ANY (ARRAY['trainer'::member_role, 'admin'::member_role])) AND (\"deletedAt\" IS NULL))"))
  // An archived member's OIB is free again, so the same person can come back.
  @@unique([taxNumber], map: "member_taxNumber_key", where: raw("(\"deletedAt\" IS NULL)"))
  @@index([orgId])
  @@map("member")
}

// A member's password. Login uses the member's email; there is none here.
model Login {
  memberId     Int      @id
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @updatedAt @db.Timestamptz
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("login")
}

// id is the SHA-256 hash of the session token; the token itself is never stored.
model Session {
  id        String   @id
  memberId  Int
  expiresAt DateTime @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("session")
}

model MemberGuardian {
  memberId   Int
  guardianId Int
  createdAt  DateTime @default(now()) @db.Timestamptz
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Restrict)

  @@id([memberId, guardianId])
  @@index([guardianId])
  @@map("member_guardian")
}

// A training group. The owner is a member with the trainer role; the service
// checks that, the database only knows the member exists.
model Group {
  id           Int                @id @default(autoincrement())
  ownerId      Int
  days         Weekday[]
  // Wall-clock times at the gym, without a date or a time zone.
  from         DateTime           @db.Time(0)
  to           DateTime           @db.Time(0)
  // Age range in whole years; either end may be open (null).
  ageFrom      Int?               @db.SmallInt
  ageTo        Int?               @db.SmallInt
  // Soft limit on the number of members; null means no limit.
  maxMembers   Int?               @db.SmallInt
  createdAt    DateTime           @default(now()) @db.Timestamptz
  updatedAt    DateTime           @updatedAt @db.Timestamptz
  // Set when the group is archived. Archived groups are hidden but kept for history.
  deletedAt    DateTime?          @db.Timestamptz
  owner        Member             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  members      GroupMember[]
  sessions     TrainingSession[]
  monthMembers GroupMonthMember[]
  auditEvents  AuditEvent[]
  enrollments  EnrollmentChild[]

  @@index([ownerId])
  @@map("group")
}

// A member who trains in a group. The service checks the member's role.
model GroupMember {
  groupId   Int
  memberId  Int
  createdAt DateTime @default(now()) @db.Timestamptz
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([groupId, memberId])
  @@index([memberId])
  @@map("group_member")
}

// One training of a group on one day. "Session" is taken by login sessions.
model TrainingSession {
  id         Int          @id @default(autoincrement())
  groupId    Int
  date       DateTime     @db.Date
  createdAt  DateTime     @default(now()) @db.Timestamptz
  group      Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attendance Attendance[]

  @@unique([groupId, date])
  @@map("training_session")
}

// A member who attended a session. No row means the member was absent.
model Attendance {
  sessionId Int
  memberId  Int
  createdAt DateTime        @default(now()) @db.Timestamptz
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member    Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([sessionId, memberId])
  @@index([memberId])
  @@map("attendance")
}

// The members shown and tickable in one month of a group. Copied from the
// group's members when the month gets its first session, then edited per month.
model GroupMonthMember {
  groupId     Int
  // The first day of the month.
  month       DateTime    @db.Date
  memberId    Int
  createdAt   DateTime    @default(now()) @db.Timestamptz
  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member      Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  // The member's subscription and payment for the month, shared by all their groups.
  memberMonth MemberMonth @relation(fields: [memberId, month], references: [memberId, month], onDelete: Restrict)

  @@id([groupId, month, memberId])
  @@index([memberId, month])
  @@map("group_month_member")
}

// One member's subscription and payment for one month, whatever groups they
// train in. Created when the member first joins a roster that month.
model MemberMonth {
  memberId                    Int
  // The first day of the month.
  month                       DateTime           @db.Date
  // The three subscription fields are set or cleared together; price and
  // sessions are copied when it is set, so later edits to the subscription
  // leave this month as it was.
  subscriptionId              Int?
  // Euro cents.
  subscriptionPrice           Int?
  subscriptionSessionsPerWeek Int?
  // Only a month with a subscription can be paid.
  paid                        Boolean            @default(false)
  // A trainer's note on the member for the month. Blank is stored as null.
  comment                     String?
  createdAt                   DateTime           @default(now()) @db.Timestamptz
  updatedAt                   DateTime           @updatedAt @db.Timestamptz
  member                      Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  subscription                Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  rosters                     GroupMonthMember[]

  @@id([memberId, month])
  @@index([subscriptionId])
  @@map("member_month")
}

// A subscription the club offers, e.g. "Kids 2x": sessions per week and a monthly price.
model Subscription {
  id              Int           @id @default(autoincrement())
  name            String        @unique
  sessionsPerWeek Int
  // Euro cents.
  price           Int
  createdAt       DateTime      @default(now()) @db.Timestamptz
  updatedAt       DateTime      @updatedAt @db.Timestamptz
  memberMonths    MemberMonth[]
  auditEvents     AuditEvent[]

  @@map("subscription")
}

// One write in the system: who did what, to which records. Written in the
// same transaction as the change. Holds ids, never copies of personal values.
model AuditEvent {
  id                  Int                @id @default(autoincrement())
  action              AuditAction
  // Null for the system (backend commands).
  actorId             Int?
  memberId            Int?
  groupId             Int?
  subscriptionId      Int?
  enrollmentRequestId Int?
  enrollmentChildId   Int?
  // The first day of the month, for month and attendance events.
  month               DateTime?          @db.Date
  // The training session's date, for session and attendance events.
  date                DateTime?          @db.Date
  // { field: { from, to } } or { field: { changed: true } } for personal values.
  changes             Json?
  createdAt           DateTime           @default(now()) @db.Timestamptz
  actor               Member?            @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  member              Member?            @relation("AuditMember", fields: [memberId], references: [id], onDelete: SetNull)
  group               Group?             @relation(fields: [groupId], references: [id], onDelete: SetNull)
  subscription        Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  enrollmentRequest   EnrollmentRequest? @relation(fields: [enrollmentRequestId], references: [id], onDelete: SetNull)
  enrollmentChild     EnrollmentChild?   @relation(fields: [enrollmentChildId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([memberId])
  @@index([groupId])
  @@index([subscriptionId])
  @@index([enrollmentRequestId])
  @@index([enrollmentChildId])
  @@map("audit_event")
}

// A parent's request to enroll one or more children, read from the club's
// enrollment form email. Nobody becomes a member until a child is accepted.
model EnrollmentRequest {
  id            Int               @id @default(autoincrement())
  parentName    String
  parentSurname String?
  parentPhone   String?
  parentEmail   String?
  // The email the request was read from.
  rawText       String?
  // The guardian created from the parent when the first child was accepted,
  // so siblings accepted later share it.
  guardianId    Int?
  createdAt     DateTime          @default(now()) @db.Timestamptz
  updatedAt     DateTime          @updatedAt @db.Timestamptz
  guardian      Guardian?         @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  children      EnrollmentChild[]
  auditEvents   AuditEvent[]

  @@index([guardianId])
  @@index([createdAt])
  @@map("enrollment_request")
}

// One child of an enrollment request.
model EnrollmentChild {
  id          Int                   @id @default(autoincrement())
  requestId   Int
  name        String
  // Years, as the parent wrote them.
  age         Decimal               @db.Decimal(3, 1)
  // The recommended group, or the one an admin chose instead.
  groupId     Int?
  status      EnrollmentChildStatus @default(pending)
  // The member created when the child was accepted.
  memberId    Int?
  createdAt   DateTime              @default(now()) @db.Timestamptz
  updatedAt   DateTime              @updatedAt @db.Timestamptz
  request     EnrollmentRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  group       Group?                @relation(fields: [groupId], references: [id], onDelete: SetNull)
  member      Member?               @relation(fields: [memberId], references: [id], onDelete: SetNull)
  auditEvents AuditEvent[]

  @@index([requestId])
  @@index([groupId, status])
  @@index([memberId])
  @@map("enrollment_child")
}
