# Base URL of the backend API. Bundled into the app and readable by anyone: never a secret.
# iOS simulator: http://localhost:3000
# Android emulator: http://10.0.2.2:3000
# Physical device: http://<your computer's LAN IP>:3000, with the backend started on HOST=0.0.0.0
EXPO_PUBLIC_API_URL=http://localhost:3000
